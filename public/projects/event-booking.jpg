<svg width="800" height="500" viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="500" fill="#111820"/>
  <rect x="100" y="80" width="600" height="340" rx="12" fill="#1e2a38" stroke="#f59e0b" stroke-width="2"/>
  <rect x="120" y="100" width="560" height="50" rx="6" fill="#0a0f14"/>
  <text x="140" y="132" font-family="system-ui" font-size="16" fill="#f59e0b">Event Booking System</text>
  <rect x="140" y="180" width="240" height="160" rx="8" fill="#0a0f14" stroke="#f59e0b" stroke-width="1"/>
  <text x="260" y="230" font-family="system-ui" font-size="14" fill="#f59e0b" text-anchor="middle">Event Browser</text>
  <text x="260" y="255" font-family="system-ui" font-size="12" fill="#8b9ab3" text-anchor="middle">• Real-time Availability\n• Categories & Search\n• Calendar View</text>
  <rect x="420" y="180" width="240" height="160" rx="8" fill="#0a0f14" stroke="#f59e0b" stroke-width="1"/>
  <text x="540" y="230" font-family="system-ui" font-size="14" fill="#f59e0b" text-anchor="middle">Booking Flow</text>
  <text x="540" y="255" font-family="system-ui" font-size="12" fill="#8b9ab3" text-anchor="middle">• Seat Selection\n• Confirmation\n• QR Tickets</text>
  <rect x="140" y="370" width="520" height="50" rx="8" fill="#f59e0b22" stroke="#f59e0b" stroke-width="1"/>
  <text x="400" y="402" font-family="system-ui" font-size="14" fill="#f59e0b" text-anchor="middle">React • Supabase • PostgreSQL • Realtime • RLS</text>
  <text x="400" y="50" font-family="system-ui" font-size="24" fill="#e8edf2" text-anchor="middle" font-weight="bold">Event Booking System</text>
  <text x="400" y="470" font-family="system-ui" font-size="14" fill="#8b9ab3" text-anchor="middle">Full-Stack Web Application</text>
</svg>